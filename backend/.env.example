# LiveStar production environment template
NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/livestar
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
OTP_DEV_MODE=false
ALLOW_TEST_BILLING=false
CORS_ORIGINS=https://app.livestar.example

# LiveKit production endpoint/credentials
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET
